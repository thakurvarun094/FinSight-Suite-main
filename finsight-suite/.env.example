# ============================================================
#  FinSight Suite — Environment Template
# ============================================================
# Copy this file to `.env` in the same directory and fill in values.
# NEVER commit the filled .env file to source control.
#
# 💡 DEMO MODE TIP: Leave SUPABASE fields blank and everything will
#    still work perfectly with built-in demo / mock data endpoints.
# ============================================================

# ── Supabase (Database + Auth + Realtime + Storage) ──────────

# Your Supabase Project URL — found in Supabase Dashboard → Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase "anon / public" key — BROWSER SAFE
# Same value used by frontend and backend (for public table reads)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_ANON_KEY_HERE

# Supabase "service_role" key — SERVER ONLY — NEVER EXPOSE TO FRONTEND
# Full bypass of RLS; used by backend for writes + admin operations
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_SERVICE_ROLE_KEY_HERE


# ── Frontend (Next.js) public env vars ──────────────────────
# These MUST be prefixed with NEXT_PUBLIC_ to be visible in browser bundles

# Same value as SUPABASE_URL above
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Same value as SUPABASE_ANON_KEY above
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_ANON_KEY_HERE

# Base URL of the FastAPI backend
# Local:  http://localhost:8000
# Prod:   https://finsight-backend.onrender.com  (or your domain)
NEXT_PUBLIC_API_URL=http://localhost:8000


# ── Backend ─────────────────────────────────────────────────

# Redis connection URL used by Celery workers + beat scheduler
# Local (default):  redis://localhost:6379/0
# Render / Upstash: redis://user:pass@host:port/db
REDIS_URL=redis://localhost:6379/0

# Supabase Storage bucket name that stores trained ML model .pkl artifacts
MODEL_BUCKET=ml-models

# Default model version string to activate on startup if none else is marked active
ACTIVE_MODEL_VERSION=1.0.0

# Public backend URL (used for redirects / CORS self-reference)
BACKEND_URL=http://localhost:8000

# Comma-separated CORS origin allowlist. Additional localhost defaults
# (http://localhost:3000, http://127.0.0.1:3000, http://localhost:8080)
# are ALWAYS added automatically by the backend for local dev.
CORS_ORIGINS=http://localhost:3000,https://finsight-frontend.onrender.com

# If true, every API endpoint returns realistic deterministic demo data
# whenever Supabase is unreachable or misconfigured.
# Keep true for hackathons / judging — the product works with zero setup.
DEMO_MODE_FALLBACK=true

# HTTP timeout (seconds) for outbound requests inside backend
REQUEST_TIMEOUT=30
